 141:Core/Src/main.c ****   memset(rx_buf, 0, BUF_SZ);
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****   while (1)
 144:Core/Src/main.c ****   {
 145:Core/Src/main.c ****     uint8_t ch;
 146:Core/Src/main.c **** 
ARM GAS  /var/folders/dl/51qyx9k12hs726902c3pspm00000gn/T//ccHyqaP1.s 			page 4


 147:Core/Src/main.c ****     // input form pc and transmitt
 148:Core/Src/main.c ****     if (HAL_UART_Receive(&huart3, &ch, 1, 100) == HAL_OK)
 149:Core/Src/main.c ****     {
 150:Core/Src/main.c ****       // echo
 151:Core/Src/main.c ****       HAL_UART_Transmit(&huart3, &ch, 1, HAL_MAX_DELAY);
 152:Core/Src/main.c **** 
 153:Core/Src/main.c ****       tx_buf[tx_len++] = ch;
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****       if (ch == '\r')
 156:Core/Src/main.c ****       {
 157:Core/Src/main.c ****         if (tx_len <= 1)
 158:Core/Src/main.c ****         {
 159:Core/Src/main.c ****           HAL_UART_Transmit(&huart3, (uint8_t*)NonEmpty, strlen(NonEmpty), 100);
 160:Core/Src/main.c ****           tx_len = 0;
 161:Core/Src/main.c ****           continue;
 162:Core/Src/main.c ****         }
 163:Core/Src/main.c ****         
 164:Core/Src/main.c ****         tx_len -= 1;
 165:Core/Src/main.c ****         CRC32_Append(tx_buf, &tx_len);
 166:Core/Src/main.c ****         tx_buf[tx_len++] = '\n';
 167:Core/Src/main.c ****         // show msg to be sent for comparison. 
 168:Core/Src/main.c ****         HAL_UART_Transmit(&huart3, (uint8_t*)"\r\n", 2, 100);
 169:Core/Src/main.c ****         HAL_UART_Transmit(&huart3, (uint8_t*)"(1) Sending: ", 13, 100);
 170:Core/Src/main.c ****         HAL_UART_Transmit(&huart3, tx_buf, tx_len, 100);
 171:Core/Src/main.c ****         HAL_UART_Transmit(&huart3, (uint8_t*)"\n\r", 2, 100);
 172:Core/Src/main.c **** 
 173:Core/Src/main.c ****         // FlipBit to test if CRC works
 174:Core/Src/main.c ****         // FlipBit(tx_buf, tx_len, 2, 1);
 175:Core/Src/main.c **** 
 176:Core/Src/main.c ****         
 177:Core/Src/main.c ****         waiting_for_ack = true;
 178:Core/Src/main.c **** 
 179:Core/Src/main.c ****         HAL_UART_Transmit(&huart2, tx_buf, tx_len, 100);
 180:Core/Src/main.c ****         for (uint16_t attempt = 1; attempt <= MAX_RETRIES; attempt++)
 181:Core/Src/main.c ****         {
 182:Core/Src/main.c ****           if (waitForACK())
 183:Core/Src/main.c ****           {
 184:Core/Src/main.c ****             blinkLED(3);
 185:Core/Src/main.c ****             break;
 186:Core/Src/main.c ****           }
 187:Core/Src/main.c ****           uint16_t i = attempt + 1;
 188:Core/Src/main.c ****           char sending[13]; 
 189:Core/Src/main.c ****           sprintf(sending, "Retry (%d)\n\r", i);
 190:Core/Src/main.c **** 
 191:Core/Src/main.c ****           HAL_UART_Transmit(&huart3, (uint8_t*)sending, 11, 100);
 192:Core/Src/main.c ****           HAL_UART_Transmit(&huart2, tx_buf, tx_len, 100); // send msg again
 193:Core/Src/main.c **** 
 194:Core/Src/main.c ****           if (!waitForACK() && attempt == MAX_RETRIES) {
 195:Core/Src/main.c ****             PrintTerm((const uint8_t *)"SEND FAILED\r\n");
 196:Core/Src/main.c ****           }
 197:Core/Src/main.c ****         }
 198:Core/Src/main.c ****         
 199:Core/Src/main.c ****         waiting_for_ack = false;
 200:Core/Src/main.c ****         tx_len = 0;
 201:Core/Src/main.c ****         // memset(tx_buf, 0, BUF_SZ);
 202:Core/Src/main.c ****       }
 203:Core/Src/main.c ****     }
ARM GAS  /var/folders/dl/51qyx9k12hs726902c3pspm00000gn/T//ccHyqaP1.s 			page 5


 204:Core/Src/main.c **** 
 205:Core/Src/main.c ****     uint8_t chrx;
 206:Core/Src/main.c ****     // recive form board and print 
 207:Core/Src/main.c ****     if (!waiting_for_ack && HAL_UART_Receive(&huart2, &chrx, 1, 10) == HAL_OK)
 208:Core/Src/main.c ****     {
 209:Core/Src/main.c ****       uint32_t now = HAL_GetTick();
 210:Core/Src/main.c ****       if (rx_len > 0 && (now - last_rx_tick) > RX_FRAME_TIMEOUT) {
 211:Core/Src/main.c ****           rx_len = 0; // reset buffer if 16B internal FiFo is overfull.
 212:Core/Src/main.c ****       }
 213:Core/Src/main.c ****       last_rx_tick = now;
 214:Core/Src/main.c ****       /* transmit in 16B blocks to allow longer msgs. */
 215:Core/Src/main.c ****       // retransmit after time out but other board just verry slow. Then other board says ACK but a
 216:Core/Src/main.c ****       // Store the new byte
 217:Core/Src/main.c ****       if (rx_len < BUF_SZ) {
 218:Core/Src/main.c ****         rx_buf[rx_len++] = chrx;
 219:Core/Src/main.c ****       }  
 220:Core/Src/main.c ****       
 221:Core/Src/main.c ****       
 222:Core/Src/main.c ****       if (chrx == '\n' || chrx == '\r')
 223:Core/Src/main.c ****       {
 224:Core/Src/main.c ****         uint16_t payload_len;
 225:Core/Src/main.c **** 
 226:Core/Src/main.c ****         if (CRC32_ValidateFrame(rx_buf, rx_len, '\n', &payload_len))
 227:Core/Src/main.c ****         {
 228:Core/Src/main.c ****             // send only the payload bytes (no CRC, no delim)
 229:Core/Src/main.c ****             HAL_UART_Transmit(&huart3, (uint8_t*)"No CRC Error\n\r> ", 16, HAL_MAX_DELAY);
 230:Core/Src/main.c ****             HAL_UART_Transmit(&huart3, rx_buf, payload_len, HAL_MAX_DELAY);
 231:Core/Src/main.c ****             HAL_UART_Transmit(&huart3, (uint8_t*)"\r\n", 2, HAL_MAX_DELAY);
 232:Core/Src/main.c **** 
 233:Core/Src/main.c ****             HAL_UART_Transmit(&huart3, (uint8_t*)"Sending ACK\n\r", 16, 100);
 234:Core/Src/main.c ****             HAL_UART_Transmit(&huart2, &ACK, 1, HAL_MAX_DELAY);
 235:Core/Src/main.c ****         }
 236:Core/Src/main.c ****         else
 237:Core/Src/main.c ****         {
 238:Core/Src/main.c ****             // bad packet
 239:Core/Src/main.c ****             HAL_UART_Transmit(&huart3, (uint8_t*)"CRC ERROR\r\n", 11, HAL_MAX_DELAY);
 240:Core/Src/main.c ****             HAL_UART_Transmit(&huart3, rx_buf, rx_len, HAL_MAX_DELAY); // rem later just to see err
 241:Core/Src/main.c ****             
 242:Core/Src/main.c ****             HAL_UART_Transmit(&huart3, (uint8_t*)"\r\n", 2, 100);
 243:Core/Src/main.c ****             HAL_UART_Transmit(&huart3, (uint8_t*)"Sending ACK\n\r", 16, 100);
 244:Core/Src/main.c ****             HAL_UART_Transmit(&huart2, &NACK, 1, HAL_MAX_DELAY); 
 245:Core/Src/main.c ****         }
 246:Core/Src/main.c **** 
 247:Core/Src/main.c ****         rx_len = 0;
 248:Core/Src/main.c ****         // memset(rx_buf, 0, BUF_SZ);
 249:Core/Src/main.c ****       }
 250:Core/Src/main.c ****     }
 251:Core/Src/main.c ****     /* USER CODE END WHILE */
 252:Core/Src/main.c **** 
 253:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 254:Core/Src/main.c ****   }
 255:Core/Src/main.c ****   /* USER CODE END 3 */
 256:Core/Src/main.c **** }
