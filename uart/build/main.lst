 273:Core/Src/main.c **** bool waitForACK(void)
 274:Core/Src/main.c **** {
 275:Core/Src/main.c ****     //uint16_t idx = 0;
 276:Core/Src/main.c ****     uint32_t start = HAL_GetTick();
 277:Core/Src/main.c ****     uint8_t ch;
 278:Core/Src/main.c **** 
 279:Core/Src/main.c ****     // Read until newline or timeout
 280:Core/Src/main.c ****     while ((HAL_GetTick() - start) < ACK_TIMEOUT_MS)
 281:Core/Src/main.c ****     {
 282:Core/Src/main.c ****         if (HAL_UART_Receive(&huart2, &ch, 1, 10) == HAL_OK){
 283:Core/Src/main.c ****         }
 284:Core/Src/main.c ****     }
 285:Core/Src/main.c **** 
 286:Core/Src/main.c ****     // Compare full string
 287:Core/Src/main.c ****     if (ch == ACK)
 288:Core/Src/main.c ****     {
 289:Core/Src/main.c ****         PrintTerm((const uint8_t *)"ACK received\r\n");
 290:Core/Src/main.c ****         return true;
 291:Core/Src/main.c ****     }
 292:Core/Src/main.c ****     else if (ch == NACK)
 293:Core/Src/main.c ****     {
 294:Core/Src/main.c ****         PrintTerm((const uint8_t*)"NACK recived\r\n");
 295:Core/Src/main.c ****         return false;
 296:Core/Src/main.c ****     }
 297:Core/Src/main.c ****     // timeout or garbage → treat as failure
 298:Core/Src/main.c ****     return false;
 299:Core/Src/main.c **** }
