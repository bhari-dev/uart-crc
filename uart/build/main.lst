 268:Core/Src/main.c **** void PrintTerm(const uint8_t *msg)
 269:Core/Src/main.c **** {
 270:Core/Src/main.c ****     HAL_UART_Transmit(&huart3, (uint8_t *)msg, strlen((const char *)msg), HAL_MAX_DELAY);
